<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted BYOK API credentials from cloud backups -->
        <exclude domain="file" path="byok_credentials.enc" />
        <exclude domain="sharedpref" path="byok_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude encrypted BYOK API credentials from device-to-device transfers -->
        <exclude domain="file" path="byok_credentials.enc" />
        <exclude domain="sharedpref" path="byok_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
